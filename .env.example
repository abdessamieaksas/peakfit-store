# Neon Postgres. Use the pooled URL at runtime and direct URL for migrations.
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@host.neon.tech/neondb?sslmode=require
STORE_DATA_SOURCE=sample

# Neon Auth
NEON_AUTH_BASE_URL=https://your-auth-endpoint.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Store configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=212719427447
ORDER_RESERVATION_MINUTES=1440
RESERVATION_CLEANUP_SECRET=replace-me

# Automatic order notifications. Resend is the free/default channel.
ADMIN_ORDER_EMAIL=orders@example.com
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Peakfit <orders@example.com>
CRON_SECRET=replace-with-at-least-16-random-characters

# WhatsApp checkout uses a customer-confirmed wa.me draft; no API credentials required.

# Product-media storage adapter (configured when the provider is selected)
MEDIA_STORAGE_PROVIDER=
MEDIA_STORAGE_TOKEN=

# Optional analytics adapters
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
